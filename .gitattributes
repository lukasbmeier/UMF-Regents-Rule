# Git on Windows would otherwise check out CRLF, which breaks tests/run_tests.sh under bash
# ("\r: command not found") for anyone cloning this template.
* text=auto eol=lf

*.exe binary
*.pck binary
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.glb binary
# Batch files need Windows line endings (cmd mis-reads labels in LF files).
*.cmd text eol=crlf

# Generated bindings are each game's own (its genres' tables): a `git pull template main` keeps the
# game's copy, and the game regenerates them after the pull (tools/publish.sh --codegen), never
# merges them. Needs the driver once per clone: git config merge.ours.driver true
# (docs/TEMPLATE_WORKFLOW.md, DECISIONS #196).
spacetime_bindings/** merge=ours
# What a repo IS (its GAME.md) and which game it is (shared/game.json: genres, database, compat) are
# each game's own: a pull keeps the game's copy (same driver).
GAME.md merge=ours
shared/game.json merge=ours
# Codegen writes the game's own database name into the addon's config.
addons/SpacetimeDB/plugin_config.tres merge=ours
# The character preview names the game's own character: each game's.
game/characters/character_preview.tscn merge=ours
# Each repo's own instructions for Claude Code (CLAUDE.md) and where its last session stopped
# (docs/HANDOFF.md): a pull keeps the game's copy (same driver). The template's .claude/rules/umf-*.md
# are the foundation's and DO arrive; a game's .claude/rules/<game>-*.md never collide with them.
CLAUDE.md merge=ours
docs/HANDOFF.md merge=ours
