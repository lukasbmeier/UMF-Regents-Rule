# Godot
.godot/
/android/
*.translation

# Exported builds
/build/
/export/
*.pck
*.exe
*.zip

# Rust / SpacetimeDB module
server/target/
**/*.rs.bk

# Animation sources: 68 MB of FBX in, 3.7 MB of .res out (game/anim/ATTRIBUTION.md)
game/anim/_import/

# Local tool state
.godotrc
addons/.godot_ai_update/

# OS
Thumbs.db
desktop.ini
.DS_Store

# NOT ignored on purpose (AGENTS.md / addons/README.md require these committed):
#   addons/SpacetimeDB/        vendored SDK — never depend on a live download
#   spacetime_bindings/        generated bindings, committed after codegen
#   project.godot              autoload order is the boot sequence
#   foundation/sim/movement_config.tres  generated from shared/movement_config.json

# This machine's script settings (tools/local.env.example says what goes in it)
tools/local.env

# The preview's Save Pictures sheets (regenerated; res://grip_pictures/.gdignore keeps them out of the import)
grip_pictures/

# Windows leaves these beside a library it could not overwrite while it was loaded.
~*.TMP
addons/terrain_3d/bin/~*

# Workbench thumbnails: a cache the Catalog regenerates (DECISIONS #203); the .gdignore keeps them out of the import.
tools/workbench/thumbnails/*
!tools/workbench/thumbnails/.gdignore

# LimboAI (the bots' behaviour trees): only the Windows, Linux and macOS libraries are committed (39 MB: the
# editor, the game, a Linux server, the Mac app). The others (Android, iOS, web: 49 MB) stay on the machine
# they were unpacked on; exporting for one of those needs them put back (addons/limboai's release zip).
addons/limboai/bin/*android*
addons/limboai/bin/*ios*
addons/limboai/bin/*web*
# The copy Godot keeps of a library while it is loaded.
addons/limboai/bin/~*
# The add-ons' own demos (LimboAI's agents, Sky3D's scene): local, to look at.
/demo/

# Claude Code's settings for this machine (auto memory shared across UMF ALL: CLAUDE.md)
.claude/settings.local.json

# Python
__pycache__/
