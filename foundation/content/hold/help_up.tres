[ext_resource type="Resource" path="res://foundation/content/status/normal.tres" id="6_normal"]

[resource]
script = ExtResource("1_hold")
done_to = Array[ExtResource("2_entdef")]([ExtResource("3_humanoid"), ExtResource("4_npc")])
