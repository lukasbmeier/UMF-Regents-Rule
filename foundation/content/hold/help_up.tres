[ext_resource type="Script" path="res://foundation/core/entity_definition.gd" id="2_entdef"]
[ext_resource type="Resource" path="res://foundation/content/character/humanoid.tres" id="3_humanoid"]
[ext_resource type="Resource" path="res://foundation/content/character/npc.tres" id="4_npc"]
