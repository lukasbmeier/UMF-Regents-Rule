[gd_resource type="Resource" script_class="RuleSetDef" load_steps=17 format=3]

[ext_resource type="Script" path="res://foundation/content/rule_set_def.gd" id="1_set"]
[ext_resource type="Script" path="res://foundation/content/rule_entry.gd" id="2_rule"]

[sub_resource type="Resource" id="Rule_interact"]
script = ExtResource("2_rule")
name = &"interact_range_m"
number = 3.0
minimum = 0.5
maximum = 20.0
unit = "m"
description = "How close a player must be to use something (a door, a spot, an NPC). The server refuses a use from further away; the prompt on screen uses the same number, so it never offers what will be refused."

[sub_resource type="Resource" id="Rule_health"]
script = ExtResource("2_rule")
name = &"new_player_health"
number = 100.0
minimum = 1.0
maximum = 10000.0
unit = "hp"
description = "The health a player starts with the first time they join. A player who has joined before keeps theirs."

[sub_resource type="Resource" id="Rule_linger"]
script = ExtResource("2_rule")
name = &"offline_linger_s"
number = 5.0
minimum = 0.0
maximum = 600.0
unit = "s"
description = "How long a player who disconnects stays standing in the world before their character leaves it. Covers a dropped connection that comes straight back; 0 makes them vanish at once. Their progress is kept either way."

[sub_resource type="Resource" id="Rule_status_grace"]
script = ExtResource("2_rule")
name = &"status_grace_ms"
kind = 1
number = 500.0
minimum = 0.0
maximum = 3000.0
unit = "ms"
description = "After a player's status changes (downed, carried), how long the server still allows the speed they had before. Their game hears of the change a round trip later and keeps moving as it was until then; without this the server would pull them back. Raise it for players far from the server."

[sub_resource type="Resource" id="Rule_status_reset"]
script = ExtResource("2_rule")
name = &"statuses_reset_each_match"
kind = 2
number = 1.0
minimum = 0.0
maximum = 1.0
description = "Whether everyone in a world goes back to normal (not downed, not out) when a new match begins there. Off for a game whose statuses last across matches."

[sub_resource type="Resource" id="Rule_hold_slack"]
script = ExtResource("2_rule")
name = &"hold_leave_slack_m"
number = 0.5
minimum = 0.0
maximum = 5.0
unit = "m"
description = "How far past a hold's reach (helping someone up, laying an egg) a player may drift before they let go of it. A little leeway, so someone standing at the edge of the reach is not dropped by their own small movements."

[sub_resource type="Resource" id="Rule_hold_speed"]
script = ExtResource("2_rule")
name = &"hold_speed"
number = 1.0
minimum = 0.05
maximum = 10.0
unit = "x"
description = "How fast every hold goes (helping someone up, laying an egg), as a share of the time its content says: 0.5 makes each take twice as long, 2 half as long. For tuning a game's pace live; a hold's own times are in its content."

[sub_resource type="Resource" id="Rule_press_credit"]
script = ExtResource("2_rule")
name = &"press_credit_cap_ms"
kind = 1
number = 120.0
minimum = 0.0
maximum = 300.0
unit = "ms"
description = "A timed press (a skill check: press when the marker is in the zone) is judged where the marker was when the player SAW it: the press's arrival less half their quickest round trip to the server. This caps that credit, so a slow or tampered connection cannot buy more than this. 0: judged on arrival, as if everyone were next to the server."

[sub_resource type="Resource" id="Rule_press_lead"]
script = ExtResource("2_rule")
name = &"press_lead_in_ms"
kind = 1
number = 800.0
minimum = 0.0
maximum = 5000.0
unit = "ms"
description = "How long after a timed press appears its marker starts to move: time for it to reach the player and for them to see it."

[sub_resource type="Resource" id="Rule_press_easy"]
script = ExtResource("2_rule")
name = &"press_sweep_easy_s"
number = 2.4
minimum = 0.3
maximum = 10.0
unit = "s"
description = "How long the marker of an EASY timed press takes to sweep across and back. Longer is easier to hit."

[sub_resource type="Resource" id="Rule_press_hard"]
script = ExtResource("2_rule")
name = &"press_sweep_hard_s"
number = 1.2
minimum = 0.3
maximum = 10.0
unit = "s"
description = "How long the marker of a HARD timed press takes to sweep across and back. A press of middling difficulty is between this and the easy one."

[sub_resource type="Resource" id="Rule_rewind"]
script = ExtResource("2_rule")
name = &"rewind_max_ms"
kind = 1
number = 150.0
minimum = 0.0
maximum = 300.0
unit = "ms"
description = "How far back the referee may look when it judges an ability (a pounce): it sees everyone where the user saw them, up to this long ago. Favours the attacker by up to this much; 0 judges everything as it is when it lands."

[sub_resource type="Resource" id="Rule_friendly_collision"]
script = ExtResource("2_rule")
name = &"friendly_collision"
kind = 2
number = 0.0
minimum = 0.0
maximum = 1.0
unit = ""
description = "FRIENDLY COLLISION (DECISIONS #238, a lobby's griefing toggle): whether characters of the same kind are solid to each other (a character's kin_layer: Fowl Play's hens block a gap for each other). Off by default: they pass through each other. Players' games follow it live; a bot is solid only to the bots its referee drives."

[sub_resource type="Resource" id="Rule_telemetry_window"]
script = ExtResource("2_rule")
name = &"telemetry_window_s"
number = 30.0
minimum = 1.0
maximum = 600.0
unit = "s"
description = "TELEMETRY (DECISIONS #244): how often each player's game and each referee reports how it ran (one small call a window: frame times, spikes, ping, corrections). Longer: fewer, coarser reports."

[sub_resource type="Resource" id="Rule_telemetry_spike"]
script = ExtResource("2_rule")
name = &"telemetry_spike_ms"
number = 50.0
minimum = 10.0
maximum = 2000.0
unit = "ms"
description = "TELEMETRY: a frame slower than this is a SPIKE, reported with the server time it happened (a lag a player felt). 50 ms is three frames at 60 Hz."

[resource]
script = ExtResource("1_set")
display_name = "Foundation rules"
designer_notes = "The foundation's hot rules: live-tunable by an admin (set_rule), served to every client. A game changes one for itself with an override in its genre's rule set, never by editing this file."
rules = Array[ExtResource("2_rule")]([SubResource("Rule_interact"), SubResource("Rule_health"), SubResource("Rule_linger"), SubResource("Rule_status_grace"), SubResource("Rule_status_reset"), SubResource("Rule_hold_slack"), SubResource("Rule_hold_speed"), SubResource("Rule_press_credit"), SubResource("Rule_press_lead"), SubResource("Rule_press_easy"), SubResource("Rule_press_hard"), SubResource("Rule_rewind"), SubResource("Rule_friendly_collision"), SubResource("Rule_telemetry_window"), SubResource("Rule_telemetry_spike")])
