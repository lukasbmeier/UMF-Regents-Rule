[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://foundation/ui/connect_screen.gd" id="1_screen"]

[sub_resource type="StyleBoxFlat" id="Style_panel"]
bg_color = Color(0.1, 0.12, 0.15, 0.97)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.45, 0.6, 0.6)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
shadow_color = Color(0, 0, 0, 0.4)
shadow_size = 12

[sub_resource type="StyleBoxEmpty" id="Style_none"]

[node name="ConnectScreen" type="CanvasLayer"]
layer = 20
script = ExtResource("1_screen")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.07, 0.09, 0.93)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(480, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("Style_panel")

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Game"

[node name="Subtitle" type="Label" parent="Center/Panel/Margin/VBox"]
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
text = "Join a server"

[node name="Gap" type="Control" parent="Center/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 4)
layout_mode = 2

[node name="HostLabel" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
text = "Server address"

[node name="Host" type="LineEdit" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "192.168.1.20   or   http://host:3000"
select_all_on_focus = true
keep_editing_on_text_submit = true

[node name="NameLabel" type="Label" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
text = "Your name"

[node name="Name" type="LineEdit" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "shown above your head"
max_length = 20
select_all_on_focus = true
keep_editing_on_text_submit = true

[node name="AutoConnect" type="CheckButton" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Connect automatically next time"

[node name="Buttons" type="HBoxContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Connect" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_horizontal = 3
text = "Connect"

[node name="Quit" type="Button" parent="Center/Panel/Margin/VBox/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 38)
layout_mode = 2
text = "Quit"

[node name="More" type="HBoxContainer" parent="Center/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Character" type="Button" parent="Center/Panel/Margin/VBox/More"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
size_flags_horizontal = 3
text = "Character"

[node name="Settings" type="Button" parent="Center/Panel/Margin/VBox/More"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
size_flags_horizontal = 3
text = "Settings"

[node name="Status" type="Label" parent="Center/Panel/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(424, 0)
layout_mode = 2
autowrap_mode = 3

[node name="Hint" type="Label" parent="Center/Panel/Margin/VBox"]
modulate = Color(1, 1, 1, 0.45)
custom_minimum_size = Vector2(424, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 13
theme_override_styles/normal = SubResource("Style_none")
text = "Hosting? Run  spacetime start --listen-addr 0.0.0.0:3000  and give your friends this machine's LAN address."
autowrap_mode = 3
