hits = Array[Resource]([SubResource("Hit_pin"), SubResource("Hit_kick")])
draws = true
draw_full_ms = 800
id = 40003
display_name = "Bow"
designer_notes = "THE BOW (owner, 2026-10-20): hold the left button to draw (you walk), let go to loose an arrow: at your Tab target (auto-aimed, a hit chance that falls with distance and a moving target) or, with none, where you aim. A quick release does 30 % and flies short; a full draw (draw_full_ms) all of it. Best at range: inside regents.point_blank_m it does regents.point_blank_pct. Each shot takes an arrow from the bag. Its skills (Q a shot up close, E a pick, R the ult) are swings judged as sweeps ahead: they take no arrow. PLACEHOLDER POOL (armor run P1, 2026-11-15): one pool for every handle until per-role pools exist on the server (Lane S); the options and the ult are stand-ins, every name ending (placeholder), Luke's to rewrite (ABILITIES_PREP.md section 9)."
