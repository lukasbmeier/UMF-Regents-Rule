[sub_resource type="Resource" id="Hit_hamstring"]
script = ExtResource("h_script")
ability = ExtResource("p2")
status = ExtResource("h_slow")
status_ms = 3000

[sub_resource type="Resource" id="Hit_bash"]
script = ExtResource("h_script")
ability = ExtResource("p3")
push_mps = 8.0

[sub_resource type="Resource" id="Role_damage"]
script = ExtResource("3_kit_role")
role = ExtResource("r_damage")
finisher = ExtResource("a2")
does = "The string ends in a piercing thrust: the hardest hit, and the longest reach."

[sub_resource type="Resource" id="Role_tank"]
script = ExtResource("3_kit_role")
role = ExtResource("r_tank")
finisher = ExtResource("a5")
stagger_pct = 150
does = "The string ends in a pommel bash that holds the foe reeling longer."

[sub_resource type="Resource" id="Role_support"]
script = ExtResource("3_kit_role")
role = ExtResource("r_support")
finisher = ExtResource("a6")
heal = 8.0
heal_radius_m = 6.0
does = "The string ends in a wide rallying cut that mends you and the players near you."

[resource]
script = ExtResource("1_kit")
key = &"sword"
skill = ExtResource("2_skill")
light = Array[Resource]([ExtResource("a0"), ExtResource("a1"), ExtResource("a2")])
follow_ms = PackedInt32Array(200, 200, 200)
roles = Array[ExtResource("3_kit_role")]([SubResource("Role_damage"), SubResource("Role_tank"), SubResource("Role_support")])
skills = Array[Resource]([ExtResource("a4"), ExtResource("p1"), ExtResource("p2"), ExtResource("p3"), ExtResource("p4")])
skill_ranks = PackedInt32Array(1, 1, 1, 1, 1)
skill_slots = PackedInt32Array(0, 1, 1, 1, 2)
hits = Array[Resource]([SubResource("Hit_hamstring"), SubResource("Hit_bash")])
id = 40001
display_name = "Sword"
designer_notes = "The sword (COMBAT_OVERHAUL.md §5, Luke 2026-11-01): its role map is the first, the handle's shape choosing the string's last hit: the plain grip a piercing thrust, the crossguard hilt a pommel bash, the banner hilt a rallying cut. PLACEHOLDER POOL (armor run P1, 2026-11-15): one pool for every handle until per-role pools exist on the server (Lane S); the options and the ult are stand-ins, every name ending (placeholder), Luke's to rewrite (ABILITIES_PREP.md section 9)."
