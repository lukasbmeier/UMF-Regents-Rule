[gd_resource type="Resource" script_class="RuleSetDef" load_steps=35 format=3]

[ext_resource type="Script" path="res://foundation/content/rule_set_def.gd" id="1_set"]
[ext_resource type="Script" path="res://foundation/content/rule_entry.gd" id="2_rule"]
[ext_resource type="Script" path="res://foundation/content/rule_override.gd" id="3_over"]

[sub_resource type="Resource" id="Rule_active_yield"]
script = ExtResource("2_rule")
name = &"active_yield_mult"
number = 1.25
minimum = 1.0
maximum = 3.0
unit = "x"
description = "DUAL-MODE SKILLING (owner, 2026-10-18): a skill played actively (its minigame, played to a full score) yields this many times what AFK yields in the same time. AFK stays a real option: keep this small. A round's pay runs from `active_yield_floor` (a score of 0) to this (a full score)."

[sub_resource type="Resource" id="Rule_active_yield_floor"]
script = ExtResource("2_rule")
name = &"active_yield_floor"
number = 0.75
minimum = 0.0
maximum = 1.0
unit = "x"
description = "WHAT A PLAYED ROUND PAYS AT A SCORE OF 0, as a share of AFK (Luke's M11, 2026-11-05: a good round beats AFK and a poor one still falls short, the break-even near half a score, not 80 %). Pay runs straight from this to `active_yield_mult` at a full score: 0.75 with 1.25 breaks even at 50 %. 0 is the curve before M11 (the multiplier times the score). Keep it under 1, so an unplayed round never beats AFK."

[sub_resource type="Resource" id="Rule_rank_ease_pct"]
script = ExtResource("2_rule")
name = &"rank_ease_pct"
number = 4.0
minimum = 0.0
maximum = 15.0
unit = "%"
description = "RANK EASES THE ROUND (Luke's M3, 2026-11-05): for each mastery rank above what a node or recipe needs, its round's windows are this much wider (the rock's notch, the beat's windows, the furnace's band, the anvil's heat and its error scale; a branch staggers for this much less). Capped by `rank_ease_ranks`. Copper is hard at rank 1 and easier at rank 4; iron is hard again when it opens."

[sub_resource type="Resource" id="Rule_rank_ease_ranks"]
script = ExtResource("2_rule")
name = &"rank_ease_ranks"
number = 3.0
minimum = 0.0
maximum = 9.0
unit = "ranks"
description = "RANK EASES THE ROUND (Luke's M3): how many ranks above the requirement count toward `rank_ease_pct` (three: at most 12 % wider at 4 % a rank). 0 turns the ease off."

[sub_resource type="Resource" id="Rule_active_rare"]
script = ExtResource("2_rule")
name = &"active_rare_mult"
number = 3.0
minimum = 1.0
maximum = 6.0
unit = "x"
description = "DUAL-MODE SKILLING: a round played to a full score is this many times as likely to find a rare material (the catalysts) as AFK; the edge grows with the score, none at 0 (Luke's M11, 2026-11-05: the catalysts lean hard to active play; 1.3 before). AFK can find rares too."

[sub_resource type="Resource" id="Rule_reach"]
script = ExtResource("2_rule")
name = &"work_reach_m"
number = 3.0
minimum = 1.0
maximum = 10.0
unit = "m"
description = "How close to a node (a tree, a rock) or a station a player must stand to work it, AFK or in a round. The server checks it when the work starts and again when a round is scored."

[sub_resource type="Resource" id="Rule_afk_move"]
script = ExtResource("2_rule")
name = &"afk_stop_moving_m"
number = 1.0
minimum = 0.1
maximum = 10.0
unit = "m"
description = "AFK work (gathering, crafting) stops when the player moves this far from where they started."

[sub_resource type="Resource" id="Rule_craft_share"]
script = ExtResource("2_rule")
name = &"craft_work_share_pct"
number = 60.0
minimum = 0.0
maximum = 200.0
unit = "%"
description = "CRAFT XP (owner, 2026-10-19): a batch pays its own XP plus this share of the XP its inputs took to gather and make, so an hour at the anvil keeps pace with an hour at the rocks."

[sub_resource type="Resource" id="Rule_variety_drain"]
script = ExtResource("2_rule")
name = &"variety_drain_pm_per_min"
number = 60.0
minimum = 0.0
maximum = 1000.0
unit = "permille/min"
description = "VARIETY: each minute of work on one recipe drains its freshness this much (thousandths); its XP falls with it, down to variety_floor_pct. Against one-recipe grinds."

[sub_resource type="Resource" id="Rule_variety_recover"]
script = ExtResource("2_rule")
name = &"variety_recover_pm_per_min"
number = 30.0
minimum = 0.0
maximum = 1000.0
unit = "permille/min"
description = "VARIETY: a recipe's freshness comes back this much a minute (thousandths), whatever you are doing."

[sub_resource type="Resource" id="Rule_variety_floor"]
script = ExtResource("2_rule")
name = &"variety_floor_pct"
number = 50.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "VARIETY: a recipe worn fully stale still pays this share of its XP."

[sub_resource type="Resource" id="Rule_first_make"]
script = ExtResource("2_rule")
name = &"first_make_mult"
number = 5.0
minimum = 0.0
maximum = 50.0
unit = "x"
description = "FIRST MAKE: the first batch a character ever makes of a recipe pays this many times a batch's XP on top."

[sub_resource type="Resource" id="Rule_order_minutes"]
script = ExtResource("2_rule")
name = &"order_minutes"
number = 3.0
minimum = 0.5
maximum = 60.0
unit = "min"
description = "WORK ORDERS: an order wants about this many minutes of AFK work of its recipe."

[sub_resource type="Resource" id="Rule_order_rotate"]
script = ExtResource("2_rule")
name = &"order_rotate_min"
number = 20.0
minimum = 1.0
maximum = 1440.0
unit = "min"
description = "WORK ORDERS: each order on the board is replaced this often."

[sub_resource type="Resource" id="Rule_order_bonus"]
script = ExtResource("2_rule")
name = &"order_bonus_pct"
number = 100.0
minimum = 0.0
maximum = 1000.0
unit = "%"
description = "WORK ORDERS: filling one pays this share of the XP its batches paid, again, on top."

[sub_resource type="Resource" id="Rule_roll"]
script = ExtResource("2_rule")
name = &"roll_ms"
number = 550.0
minimum = 100.0
maximum = 2000.0
unit = "ms"
description = "COMBAT (owner, 2026-10-19): a dodge roll cannot be hit for this long (the Rolling status)."

[sub_resource type="Resource" id="Rule_parry"]
script = ExtResource("2_rule")
name = &"parry_ms"
number = 200.0
minimum = 0.0
maximum = 1000.0
unit = "ms"
description = "THE PARRY (COMBAT_OVERHAUL.md section 4): a hit that lands this soon after a guard press (the right button), judged as the player SAW it (the press less its trip and the view delay), is PARRIED: no damage, the attacker staggered, a riposte window opened."

[sub_resource type="Resource" id="Rule_stagger"]
script = ExtResource("2_rule")
name = &"stagger_ms"
number = 800.0
minimum = 0.0
maximum = 3000.0
unit = "ms"
description = "COMBAT: how long a parried attacker, or one whose poise the string's last hit breaks (a player: any last hit), cannot act (the guard grip's bash longer)."

[sub_resource type="Resource" id="Rule_poise_light"]
script = ExtResource("2_rule")
name = &"poise_light"
number = 10.0
minimum = 0.0
maximum = 1000.0
unit = ""
description = "COMBAT, POISE (Luke, 2026-11-02): how much of a foe's or a dummy's poise a melee hit wears (a light, a skill); it never breaks it (it stops at 1). FoeDef.poise is a foe's whole."

[sub_resource type="Resource" id="Rule_poise_finisher"]
script = ExtResource("2_rule")
name = &"poise_finisher"
number = 40.0
minimum = 0.0
maximum = 1000.0
unit = ""
description = "COMBAT, POISE: how much the string's last hit wears (the Heavy trait more); emptied, it breaks: a stagger (regents.stagger_ms), then Steadied."

[sub_resource type="Resource" id="Rule_poise_regen"]
script = ExtResource("2_rule")
name = &"poise_regen_ms"
number = 8000.0
minimum = 0.0
maximum = 30000.0
unit = "ms"
description = "COMBAT, POISE: unhit this long, a foe's poise is whole again. Longer than the gap between a foe's openings (its combo and its rest, ~5 s), so one fighter's strings add up: at 3 s they never did (the combat playtest, 2026-11-02)."

[sub_resource type="Resource" id="Rule_steadied"]
script = ExtResource("2_rule")
name = &"steadied_ms"
number = 3000.0
minimum = 0.0
maximum = 30000.0
unit = "ms"
description = "COMBAT, POISE: after a stagger from broken poise, this long when nothing wears it (Steadied): no stagger again at once."

[sub_resource type="Resource" id="Rule_dummy_poise"]
script = ExtResource("2_rule")
name = &"dummy_poise"
number = 50.0
minimum = 0.0
maximum = 10000.0
unit = ""
description = "COMBAT, POISE: a training dummy's poise (a foe's is its FoeDef's): 50 breaks on any weapon's first string."

[sub_resource type="Resource" id="Rule_block_pct"]
script = ExtResource("2_rule")
name = &"block_damage_pct"
number = 25.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "THE FULL BLOCK (the Tank role's: a sword with a crossguard hilt; `RoleDef.full_block`): a held block takes this share of a hit in front. The others' is `weak_block_pct`."

[sub_resource type="Resource" id="Rule_xp_dmg"]
script = ExtResource("2_rule")
name = &"combat_xp_per_damage"
number = 0.5
minimum = 0.0
maximum = 10.0
unit = "xp"
description = "COMBAT: mastery XP a hit pays for each point of damage it does (in the wielded weapon's kit's skill)."

[sub_resource type="Resource" id="Rule_dummy_xp"]
script = ExtResource("2_rule")
name = &"dummy_xp_pct"
number = 50.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "COMBAT: hits on a training dummy pay this share of their mastery XP."

[sub_resource type="Resource" id="Rule_dummy_hp"]
script = ExtResource("2_rule")
name = &"dummy_hp"
number = 500.0
minimum = 10.0
maximum = 100000.0
unit = "hp"
description = "COMBAT: a training dummy's health (it never falls: it keeps one point)."

