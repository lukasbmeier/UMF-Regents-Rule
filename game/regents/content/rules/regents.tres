[gd_resource type="Resource" script_class="RuleSetDef" load_steps=15 format=3]

[ext_resource type="Script" path="res://foundation/content/rule_set_def.gd" id="1_set"]
[ext_resource type="Script" path="res://foundation/content/rule_entry.gd" id="2_rule"]

[sub_resource type="Resource" id="Rule_active_yield"]
script = ExtResource("2_rule")
name = &"active_yield_mult"
number = 1.25
minimum = 1.0
maximum = 3.0
unit = "x"
description = "DUAL-MODE SKILLING (owner, 2026-10-18): a skill played actively (its minigame, played well) yields this many times what AFK yields in the same time. AFK stays a real option: keep this small."

[sub_resource type="Resource" id="Rule_active_rare"]
script = ExtResource("2_rule")
name = &"active_rare_mult"
number = 1.3
minimum = 1.0
maximum = 3.0
unit = "x"
description = "DUAL-MODE SKILLING: active play is this many times as likely to find a rare material as AFK. AFK can find rares too."

[sub_resource type="Resource" id="Rule_reach"]
script = ExtResource("2_rule")
name = &"work_reach_m"
number = 3.0
minimum = 1.0
maximum = 10.0
unit = "m"
description = "How close to a node (a tree, a rock) or a station a player must stand to work it, AFK or in a round. The server checks it when the work starts and again when a round is scored."

[sub_resource type="Resource" id="Rule_afk_move"]
script = ExtResource("2_rule")
name = &"afk_stop_moving_m"
number = 1.0
minimum = 0.1
maximum = 10.0
unit = "m"
description = "AFK work (gathering, crafting) stops when the player moves this far from where they started."

[sub_resource type="Resource" id="Rule_craft_share"]
script = ExtResource("2_rule")
name = &"craft_work_share_pct"
number = 60.0
minimum = 0.0
maximum = 200.0
unit = "%"
description = "CRAFT XP (owner, 2026-10-19): a batch pays its own XP plus this share of the XP its inputs took to gather and make, so an hour at the anvil keeps pace with an hour at the rocks."

[sub_resource type="Resource" id="Rule_variety_drain"]
script = ExtResource("2_rule")
name = &"variety_drain_pm_per_min"
number = 60.0
minimum = 0.0
maximum = 1000.0
unit = "permille/min"
description = "VARIETY: each minute of work on one recipe drains its freshness this much (thousandths); its XP falls with it, down to variety_floor_pct. Against one-recipe grinds."

[sub_resource type="Resource" id="Rule_variety_recover"]
script = ExtResource("2_rule")
name = &"variety_recover_pm_per_min"
number = 30.0
minimum = 0.0
maximum = 1000.0
unit = "permille/min"
description = "VARIETY: a recipe's freshness comes back this much a minute (thousandths), whatever you are doing."

[sub_resource type="Resource" id="Rule_variety_floor"]
script = ExtResource("2_rule")
name = &"variety_floor_pct"
number = 50.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "VARIETY: a recipe worn fully stale still pays this share of its XP."

[sub_resource type="Resource" id="Rule_first_make"]
script = ExtResource("2_rule")
name = &"first_make_mult"
number = 5.0
minimum = 0.0
maximum = 50.0
unit = "x"
description = "FIRST MAKE: the first batch a character ever makes of a recipe pays this many times a batch's XP on top."

[sub_resource type="Resource" id="Rule_order_minutes"]
script = ExtResource("2_rule")
name = &"order_minutes"
number = 3.0
minimum = 0.5
maximum = 60.0
unit = "min"
description = "WORK ORDERS: an order wants about this many minutes of AFK work of its recipe."

[sub_resource type="Resource" id="Rule_order_rotate"]
script = ExtResource("2_rule")
name = &"order_rotate_min"
number = 20.0
minimum = 1.0
maximum = 1440.0
unit = "min"
description = "WORK ORDERS: each order on the board is replaced this often."

[sub_resource type="Resource" id="Rule_order_bonus"]
script = ExtResource("2_rule")
name = &"order_bonus_pct"
number = 100.0
minimum = 0.0
maximum = 1000.0
unit = "%"
description = "WORK ORDERS: filling one pays this share of the XP its batches paid, again, on top."

[sub_resource type="Resource" id="Rule_roll"]
script = ExtResource("2_rule")
name = &"roll_ms"
number = 550.0
minimum = 100.0
maximum = 2000.0
unit = "ms"
description = "COMBAT (owner, 2026-10-19): a dodge roll cannot be hit for this long (the Rolling status)."

[sub_resource type="Resource" id="Rule_parry"]
script = ExtResource("2_rule")
name = &"parry_ms"
number = 200.0
minimum = 0.0
maximum = 1000.0
unit = "ms"
description = "COMBAT: a hit this soon after a block went up is PARRIED: no damage, and the attacker is staggered."

[sub_resource type="Resource" id="Rule_stagger"]
script = ExtResource("2_rule")
name = &"stagger_ms"
number = 800.0
minimum = 0.0
maximum = 3000.0
unit = "ms"
description = "COMBAT: how long a parried attacker cannot act."

[sub_resource type="Resource" id="Rule_block_pct"]
script = ExtResource("2_rule")
name = &"block_damage_pct"
number = 25.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "COMBAT: a blocked hit takes this share of its damage."

[sub_resource type="Resource" id="Rule_xp_dmg"]
script = ExtResource("2_rule")
name = &"combat_xp_per_damage"
number = 0.5
minimum = 0.0
maximum = 10.0
unit = "xp"
description = "COMBAT: mastery XP a hit pays for each point of damage it does (in the wielded weapon's kit's skill)."

[sub_resource type="Resource" id="Rule_dummy_xp"]
script = ExtResource("2_rule")
name = &"dummy_xp_pct"
number = 50.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "COMBAT: hits on a training dummy pay this share of their mastery XP."

[sub_resource type="Resource" id="Rule_dummy_hp"]
script = ExtResource("2_rule")
name = &"dummy_hp"
number = 500.0
minimum = 10.0
maximum = 100000.0
unit = "hp"
description = "COMBAT: a training dummy's health (it never falls: it keeps one point)."

[sub_resource type="Resource" id="Rule_dummy_reset"]
script = ExtResource("2_rule")
name = &"dummy_reset_s"
number = 4.0
minimum = 0.5
maximum = 120.0
unit = "s"
description = "COMBAT: a training dummy is whole again this long after its last hit."

[sub_resource type="Resource" id="Rule_flinch"]
script = ExtResource("2_rule")
name = &"flinch_ms"
number = 350.0
minimum = 0.0
maximum = 2000.0
unit = "ms"
description = "COMBAT TIMING (owner, 2026-10-19): a heavy hit during a light swing's wind-up cancels it and flinches its fighter this long."

[sub_resource type="Resource" id="Rule_swing_hold"]
script = ExtResource("2_rule")
name = &"swing_hold_ms"
number = 80.0
minimum = 0.0
maximum = 1000.0
unit = "ms"
description = "COMBAT TIMING: a swing slows its fighter (the Swinging status) from its start until this long after it lands."

[sub_resource type="Resource" id="Rule_swing_slack"]
script = ExtResource("2_rule")
name = &"swing_slack_ms"
number = 120.0
minimum = 0.0
maximum = 1000.0
unit = "ms"
description = "COMBAT TIMING: the server takes a swing this much before its lock ends (the network: the client times the lock by its own presses)."

[sub_resource type="Resource" id="Rule_foe_corpse"]
script = ExtResource("2_rule")
name = &"foe_corpse_s"
number = 6.0
minimum = 0.5
maximum = 120.0
unit = "s"
description = "FOES (owner, 2026-10-19): a slain foe lies this long before it is gone."

[sub_resource type="Resource" id="Rule_foe_respawn"]
script = ExtResource("2_rule")
name = &"foe_respawn_s"
number = 60.0
minimum = 1.0
maximum = 3600.0
unit = "s"
description = "FOES: a slain foe comes back at its point this long after it fell."

[sub_resource type="Resource" id="Rule_player_respawn"]
script = ExtResource("2_rule")
name = &"player_respawn_s"
number = 5.0
minimum = 0.5
maximum = 120.0
unit = "s"
description = "FOES: a slain player gets up at the spawn, whole, this long after (a placeholder until a death penalty is decided)."

[resource]
script = ExtResource("1_set")
rules = Array[ExtResource("2_rule")]([SubResource("Rule_active_yield"), SubResource("Rule_active_rare"), SubResource("Rule_reach"), SubResource("Rule_afk_move"), SubResource("Rule_craft_share"), SubResource("Rule_variety_drain"), SubResource("Rule_variety_recover"), SubResource("Rule_variety_floor"), SubResource("Rule_first_make"), SubResource("Rule_order_minutes"), SubResource("Rule_order_rotate"), SubResource("Rule_order_bonus"), SubResource("Rule_roll"), SubResource("Rule_parry"), SubResource("Rule_stagger"), SubResource("Rule_block_pct"), SubResource("Rule_xp_dmg"), SubResource("Rule_dummy_xp"), SubResource("Rule_dummy_hp"), SubResource("Rule_dummy_reset"), SubResource("Rule_flinch"), SubResource("Rule_swing_hold"), SubResource("Rule_swing_slack"), SubResource("Rule_foe_corpse"), SubResource("Rule_foe_respawn"), SubResource("Rule_player_respawn")])
id = 40000
display_name = "Regent's Rule rules"
designer_notes = "The skilling loop's numbers: active against AFK. Tuned live on the Rules page."
