number = 30.0
reason = "An MMO with many characters: one whose player has gone stays where it stood for 30 s, then is put away until they sign in again (Luke, template 1.0 question 4)."

[sub_resource type="Resource" id="Over_two_sides"]
script = ExtResource("3_over")
key = "foundation.referee_two_sides"
number = 1.0
reason = "Players against monsters (Luke's playtest 2026-10-24, notes 2 and 3: two skeletons side by side hit each other, never him): a skeleton's swing passes through skeletons, a player's through players."

[sub_resource type="Resource" id="Over_npc_tiers"]
script = ExtResource("3_over")
key = "foundation.npc_tiers"
number = 1.0
reason = "RULE_DESIGN 6.1 (the NPC tiers, agreed 2026-10-13): a foe with no player within 400 m for 30 s sleeps until one comes within 200 m. The referee's brains were half its time at 300 players (REFEREE_SCALING.md)."

[sub_resource type="Resource" id="Rule_attack_tokens"]
script = ExtResource("2_rule")
name = &"attack_tokens"
number = 2.0
minimum = 1.0
maximum = 6.0
unit = "foes"
description = "FOE PACE (COMBAT_OVERHAUL.md section 2, 2026-10-31): at most this many foes swing at one player at a time; the rest circle, waiting their turn."

[sub_resource type="Resource" id="Rule_token_gap"]
script = ExtResource("2_rule")
name = &"token_gap_ms"
number = 600.0
minimum = 0.0
maximum = 3000.0
unit = "ms"
description = "FOE PACE: no foe's swing lands on a player sooner than this after another foe's swing landed on them (hit, parried, rolled through or missed), so two hits never arrive together."

[sub_resource type="Resource" id="Rule_foe_aim_lock"]
script = ExtResource("2_rule")
name = &"foe_aim_lock_ms"
number = 300.0
minimum = 0.0
maximum = 1500.0
unit = "ms"
description = "FOE AIM: a foe turns to follow its target through its wind-up, then stops turning this long before the hit lands. A step aside in that time slips the swing; one earlier does not."

[sub_resource type="Resource" id="Rule_combo_window"]
script = ExtResource("2_rule")
name = &"combo_window_ms"
number = 2000.0
minimum = 300.0
maximum = 5000.0
unit = "ms"
description = "THE STRING (COMBAT_OVERHAUL.md section 3, 2026-10-31): a tap this long after a step's lock ends is still the next step; later the string starts over. A guard press restarts it; a roll ends it."

[sub_resource type="Resource" id="Rule_parry_late"]
script = ExtResource("2_rule")
name = &"parry_late_ms"
number = 50.0
minimum = 0.0
maximum = 300.0
unit = "ms"
description = "THE PARRY: a guard press up to this long AFTER the hit landed, as the player saw it, still parries it (the eye and the hand forgiven a little)."

[sub_resource type="Resource" id="Rule_parry_whiff"]
script = ExtResource("2_rule")
name = &"parry_whiff_ms"
number = 400.0
minimum = 0.0
maximum = 2000.0
unit = "ms"
description = "THE PARRY'S WHIFF LOCKOUT: a guard press this soon after one that parried nothing is no parry (it still blocks), so tapping the right button nonstop does not work."

[sub_resource type="Resource" id="Rule_riposte"]
script = ExtResource("2_rule")
name = &"riposte_ms"
number = 1000.0
minimum = 0.0
maximum = 3000.0
unit = "ms"
description = "THE RIPOSTE: a string's first step begun this soon after a parry is the riposte (bonus damage, `riposte_damage_pct`), and a bow's draw begun in it fills faster (`riposte_draw_pct`)."

[sub_resource type="Resource" id="Rule_riposte_damage"]
script = ExtResource("2_rule")
name = &"riposte_damage_pct"
number = 150.0
minimum = 100.0
maximum = 400.0
unit = "%"
description = "THE RIPOSTE: its damage, as a share of the first step's."

[sub_resource type="Resource" id="Rule_riposte_draw"]
script = ExtResource("2_rule")
name = &"riposte_draw_pct"
number = 50.0
minimum = 10.0
maximum = 100.0
unit = "%"
description = "THE BOW'S RIPOSTE: a draw begun in the riposte window is full in this share of its usual time."

[sub_resource type="Resource" id="Rule_weak_block"]
script = ExtResource("2_rule")
name = &"weak_block_pct"
number = 60.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "THE WEAK BLOCK (the Damage and Support roles: a plain or banner handle): a held block takes this share of a hit in front. The Tank's full block is `block_damage_pct`."

[sub_resource type="Resource" id="Rule_guard_arc"]
script = ExtResource("2_rule")
name = &"guard_arc_deg"
number = 120.0
minimum = 0.0
maximum = 360.0
unit = "deg"
description = "THE GUARD FACES FORWARD: a block or parry stops only a hit from within this arc in front (the whole arc); from behind, the full damage."

[sub_resource type="Resource" id="Rule_hitstop"]
script = ExtResource("2_rule")
name = &"hitstop_ms"
number = 60.0
minimum = 0.0
maximum = 300.0
unit = "ms"
description = "FEEL (Luke's feedback 4098, 2026-10-31: hits with weight): a landed hit holds both bodies' animation still this long (a hit-stop). On screen only."

[sub_resource type="Resource" id="Rule_hitstop_big"]
script = ExtResource("2_rule")
name = &"hitstop_big_ms"
number = 110.0
minimum = 0.0
maximum = 400.0
unit = "ms"
description = "FEEL: the hit-stop of a big hit (20 or more) or a stagger (a parry's, a finisher's)."

[sub_resource type="Resource" id="Rule_guard_threat"]
script = ExtResource("2_rule")
name = &"guard_threat_pct"
number = 250.0
minimum = 0.0
maximum = 1000.0
unit = "%"
description = "THREAT (stored for combat overhaul step 6; nothing targets by threat yet): a weapon with a guard handle (the sword's crossguard hilt, the Tank role) counts its damage this much toward a foe's choice of target. Luke, 2026-11-01: to be tested, with its scope (`guard_threat_bosses_only`)."

[sub_resource type="Resource" id="Rule_guard_threat_scope"]
script = ExtResource("2_rule")
name = &"guard_threat_bosses_only"
kind = 2
number = 0.0
minimum = 0.0
maximum = 1.0
description = "THREAT's SCOPE: on, `guard_threat_pct` counts against bosses only (every other foe counts a guard handle's damage as plain); off, against every foe. Luke, 2026-11-01: 'maybe bosses only; test it'."

[sub_resource type="Resource" id="Rule_rally_self"]
script = ExtResource("2_rule")
name = &"rally_self_share_pct"
number = 50.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "THE RALLYING CUT (the sword's banner hilt): its user's own share of the heal when other players are near (alone, all of it). Luke, 2026-11-01: full solo, less with players near; the ratio after playing it solo and grouped."

[sub_resource type="Resource" id="Rule_drop_damage"]
script = ExtResource("2_rule")
name = &"drop_handle_damage_pct"
number = 50.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "A DROPPED WEAPON's handle shape (a sword's: the plain grip): its weight against the others' (Luke, 2026-11-01: 50 % plain, 25 / 25)."

[sub_resource type="Resource" id="Rule_drop_tank"]
script = ExtResource("2_rule")
name = &"drop_handle_tank_pct"
number = 25.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "A DROPPED WEAPON's handle shape: the guard handle's weight (a sword's crossguard hilt)."

[sub_resource type="Resource" id="Rule_drop_support"]
script = ExtResource("2_rule")
name = &"drop_handle_support_pct"
number = 25.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "A DROPPED WEAPON's handle shape: the banner handle's weight (a sword's banner hilt)."

