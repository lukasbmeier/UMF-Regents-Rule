[gd_resource type="Resource" script_class="RuleSetDef" load_steps=19 format=3]

[ext_resource type="Script" path="res://foundation/content/rule_set_def.gd" id="1_set"]
[ext_resource type="Script" path="res://foundation/content/rule_entry.gd" id="2_rule"]

[sub_resource type="Resource" id="Rule_active_yield"]
script = ExtResource("2_rule")
name = &"active_yield_mult"
number = 1.25
minimum = 1.0
maximum = 3.0
unit = "x"
description = "DUAL-MODE SKILLING (owner, 2026-10-18): a skill played actively (its minigame, played well) yields this many times what AFK yields in the same time. AFK stays a real option: keep this small."

[sub_resource type="Resource" id="Rule_active_rare"]
script = ExtResource("2_rule")
name = &"active_rare_mult"
number = 1.3
minimum = 1.0
maximum = 3.0
unit = "x"
description = "DUAL-MODE SKILLING: active play is this many times as likely to find a rare material as AFK. AFK can find rares too."

[sub_resource type="Resource" id="Rule_reach"]
script = ExtResource("2_rule")
name = &"work_reach_m"
number = 3.0
minimum = 1.0
maximum = 10.0
unit = "m"
description = "How close to a node (a tree, a rock) or a station a player must stand to work it, AFK or in a round. The server checks it when the work starts and again when a round is scored."

[sub_resource type="Resource" id="Rule_afk_move"]
script = ExtResource("2_rule")
name = &"afk_stop_moving_m"
number = 1.0
minimum = 0.1
maximum = 10.0
unit = "m"
description = "AFK work (gathering, crafting) stops when the player moves this far from where they started."

[sub_resource type="Resource" id="Rule_craft_share"]
script = ExtResource("2_rule")
name = &"craft_work_share_pct"
number = 60.0
minimum = 0.0
maximum = 200.0
unit = "%"
description = "CRAFT XP (owner, 2026-10-19): a batch pays its own XP plus this share of the XP its inputs took to gather and make, so an hour at the anvil keeps pace with an hour at the rocks."

[sub_resource type="Resource" id="Rule_variety_drain"]
script = ExtResource("2_rule")
name = &"variety_drain_pm_per_min"
number = 60.0
minimum = 0.0
maximum = 1000.0
unit = "permille/min"
description = "VARIETY: each minute of work on one recipe drains its freshness this much (thousandths); its XP falls with it, down to variety_floor_pct. Against one-recipe grinds."

[sub_resource type="Resource" id="Rule_variety_recover"]
script = ExtResource("2_rule")
name = &"variety_recover_pm_per_min"
number = 30.0
minimum = 0.0
maximum = 1000.0
unit = "permille/min"
description = "VARIETY: a recipe's freshness comes back this much a minute (thousandths), whatever you are doing."

[sub_resource type="Resource" id="Rule_variety_floor"]
script = ExtResource("2_rule")
name = &"variety_floor_pct"
number = 50.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "VARIETY: a recipe worn fully stale still pays this share of its XP."

[sub_resource type="Resource" id="Rule_first_make"]
script = ExtResource("2_rule")
name = &"first_make_mult"
number = 5.0
minimum = 0.0
maximum = 50.0
unit = "x"
description = "FIRST MAKE: the first batch a character ever makes of a recipe pays this many times a batch's XP on top."

[sub_resource type="Resource" id="Rule_order_minutes"]
script = ExtResource("2_rule")
name = &"order_minutes"
number = 3.0
minimum = 0.5
maximum = 60.0
unit = "min"
description = "WORK ORDERS: an order wants about this many minutes of AFK work of its recipe."

[sub_resource type="Resource" id="Rule_order_rotate"]
script = ExtResource("2_rule")
name = &"order_rotate_min"
number = 20.0
minimum = 1.0
maximum = 1440.0
unit = "min"
description = "WORK ORDERS: each order on the board is replaced this often."

[sub_resource type="Resource" id="Rule_order_bonus"]
script = ExtResource("2_rule")
name = &"order_bonus_pct"
number = 100.0
minimum = 0.0
maximum = 1000.0
unit = "%"
description = "WORK ORDERS: filling one pays this share of the XP its batches paid, again, on top."

[sub_resource type="Resource" id="Rule_roll"]
script = ExtResource("2_rule")
name = &"roll_ms"
number = 550.0
minimum = 100.0
maximum = 2000.0
unit = "ms"
description = "COMBAT (owner, 2026-10-19): a dodge roll cannot be hit for this long (the Rolling status)."

[sub_resource type="Resource" id="Rule_parry"]
script = ExtResource("2_rule")
name = &"parry_ms"
number = 200.0
minimum = 0.0
maximum = 1000.0
unit = "ms"
description = "COMBAT: a hit this soon after a block went up is PARRIED: no damage, and the attacker is staggered."

[sub_resource type="Resource" id="Rule_stagger"]
script = ExtResource("2_rule")
name = &"stagger_ms"
number = 800.0
minimum = 0.0
maximum = 3000.0
unit = "ms"
description = "COMBAT: how long a parried attacker cannot act."

[sub_resource type="Resource" id="Rule_block_pct"]
script = ExtResource("2_rule")
name = &"block_damage_pct"
number = 25.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "COMBAT: a blocked hit takes this share of its damage."

[sub_resource type="Resource" id="Rule_xp_dmg"]
script = ExtResource("2_rule")
name = &"combat_xp_per_damage"
number = 0.5
minimum = 0.0
maximum = 10.0
unit = "xp"
description = "COMBAT: mastery XP a hit pays for each point of damage it does (in the wielded weapon's kit's skill)."

[sub_resource type="Resource" id="Rule_dummy_xp"]
script = ExtResource("2_rule")
name = &"dummy_xp_pct"
number = 50.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "COMBAT: hits on a training dummy pay this share of their mastery XP."

[sub_resource type="Resource" id="Rule_dummy_hp"]
script = ExtResource("2_rule")
name = &"dummy_hp"
number = 500.0
minimum = 10.0
maximum = 100000.0
unit = "hp"
description = "COMBAT: a training dummy's health (it never falls: it keeps one point)."

[sub_resource type="Resource" id="Rule_dummy_reset"]
script = ExtResource("2_rule")
name = &"dummy_reset_s"
number = 4.0
minimum = 0.5
maximum = 120.0
unit = "s"
description = "COMBAT: a training dummy is whole again this long after its last hit."

[sub_resource type="Resource" id="Rule_flinch"]
script = ExtResource("2_rule")
name = &"flinch_ms"
number = 350.0
minimum = 0.0
maximum = 2000.0
unit = "ms"
description = "COMBAT TIMING (owner, 2026-10-19): a heavy hit during a light swing's wind-up cancels it and flinches its fighter this long."

[sub_resource type="Resource" id="Rule_swing_hold"]
script = ExtResource("2_rule")
name = &"swing_hold_ms"
number = 80.0
minimum = 0.0
maximum = 1000.0
unit = "ms"
description = "COMBAT TIMING: a swing slows its fighter (the Swinging status) from its start until this long after it lands."

[sub_resource type="Resource" id="Rule_swing_slack"]
script = ExtResource("2_rule")
name = &"swing_slack_ms"
number = 120.0
minimum = 0.0
maximum = 1000.0
unit = "ms"
description = "COMBAT TIMING: the server takes a swing this much before its lock ends (the network: the client times the lock by its own presses)."

[sub_resource type="Resource" id="Rule_foe_corpse"]
script = ExtResource("2_rule")
name = &"foe_corpse_s"
number = 6.0
minimum = 0.5
maximum = 120.0
unit = "s"
description = "FOES (owner, 2026-10-19): a slain foe lies this long before it is gone."

[sub_resource type="Resource" id="Rule_foe_respawn"]
script = ExtResource("2_rule")
name = &"foe_respawn_s"
number = 60.0
minimum = 1.0
maximum = 3600.0
unit = "s"
description = "FOES: a slain foe comes back at its point this long after it fell."

[sub_resource type="Resource" id="Rule_regen_delay"]
script = ExtResource("2_rule")
name = &"regen_delay_s"
number = 8.0
minimum = 0.0
maximum = 120.0
unit = "s"
description = "HEALTH (2026-10-20): out of the fight this long after your last hurt (no hit landing on you), your health starts to come back. Foes too."

[sub_resource type="Resource" id="Rule_regen_pct"]
script = ExtResource("2_rule")
name = &"regen_pct_per_s"
number = 4.0
minimum = 0.0
maximum = 100.0
unit = "%/s"
description = "HEALTH: then this much of your health comes back a second (4: empty to whole in 25 s)."

[sub_resource type="Resource" id="Rule_player_respawn"]
script = ExtResource("2_rule")
name = &"player_respawn_s"
number = 5.0
minimum = 0.5
maximum = 120.0
unit = "s"
description = "FOES: a slain player gets up at the spawn, whole, this long after (a placeholder until a death penalty is decided)."

[sub_resource type="Resource" id="Rule_draw_min_power_pct"]
script = ExtResource("2_rule")
name = &"draw_min_power_pct"
number = 30.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "THE BOW (owner, 2026-10-20): a quick release looses at this much of the shot (damage, speed); a full draw at all of it."

[sub_resource type="Resource" id="Rule_arrow_speed_min"]
script = ExtResource("2_rule")
name = &"arrow_speed_min"
number = 20.0
minimum = 5.0
maximum = 60.0
unit = "m/s"
description = "THE BOW: an arrow from the quickest release flies this fast..."

[sub_resource type="Resource" id="Rule_arrow_speed_max"]
script = ExtResource("2_rule")
name = &"arrow_speed_max"
number = 50.0
minimum = 5.0
maximum = 60.0
unit = "m/s"
description = "THE BOW: ...and from a full draw this fast (it flies further and flatter)."

[sub_resource type="Resource" id="Rule_bow_range_m"]
script = ExtResource("2_rule")
name = &"bow_range_m"
number = 40.0
minimum = 5.0
maximum = 120.0
unit = "m"
description = "THE BOW: a Tab target this near is auto-aimed at; further, the arrow flies where you look."

[sub_resource type="Resource" id="Rule_hit_near_m"]
script = ExtResource("2_rule")
name = &"hit_near_m"
number = 8.0
minimum = 0.0
maximum = 100.0
unit = "m"
description = "THE BOW: an auto-aimed arrow hits hit_near_pct of the time within this..."

[sub_resource type="Resource" id="Rule_hit_far_m"]
script = ExtResource("2_rule")
name = &"hit_far_m"
number = 40.0
minimum = 1.0
maximum = 200.0
unit = "m"
description = "THE BOW: ...falling to hit_far_pct at this distance."

[sub_resource type="Resource" id="Rule_hit_near_pct"]
script = ExtResource("2_rule")
name = &"hit_near_pct"
number = 95.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "THE BOW: the chance to hit up close."

[sub_resource type="Resource" id="Rule_hit_far_pct"]
script = ExtResource("2_rule")
name = &"hit_far_pct"
number = 55.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "THE BOW: the chance to hit at hit_far_m."

[sub_resource type="Resource" id="Rule_hit_moving_pct"]
script = ExtResource("2_rule")
name = &"hit_moving_pct"
number = 15.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "THE BOW: less this when the target is on the move. (A roll dodges it outright.)"

[sub_resource type="Resource" id="Rule_point_blank_m"]
script = ExtResource("2_rule")
name = &"point_blank_m"
number = 4.0
minimum = 0.0
maximum = 20.0
unit = "m"
description = "THE BOW: an arrow that hits nearer than this to where it left the bow is point blank..."

[sub_resource type="Resource" id="Rule_point_blank_pct"]
script = ExtResource("2_rule")
name = &"point_blank_pct"
number = 60.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "THE BOW: ...and does this much of its damage: a bow wants distance."

[sub_resource type="Resource" id="Rule_arrow_recover_pct"]
script = ExtResource("2_rule")
name = &"arrow_recover_pct"
number = 40.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "THE BOW: this share of the arrows stuck in a foe come back to their owners when it falls."

[sub_resource type="Resource" id="Rule_grade_fine_q"]
script = ExtResource("2_rule")
name = &"grade_fine_q"
number = 400.0
minimum = 1.0
maximum = 1000.0
unit = "‰"
description = "GRADES (owner, 2026-10-20): a made item of at least this quality (thousandths) is Fine; below it, Common."

[sub_resource type="Resource" id="Rule_grade_masterwork_q"]
script = ExtResource("2_rule")
name = &"grade_masterwork_q"
number = 800.0
minimum = 1.0
maximum = 1000.0
unit = "‰"
description = "GRADES: a made item of at least this quality (thousandths) is Masterwork."

[sub_resource type="Resource" id="Rule_mana_cost_pct"]
script = ExtResource("2_rule")
name = &"mana_cost_pct"
number = 100.0
minimum = 0.0
maximum = 1000.0
unit = "%"
description = "THE STAFF (owner, 2026-10-20): every spell's cost, in percent of what its SpellDef says (a balance dial: 120 makes casting dearer)."

[sub_resource type="Resource" id="Rule_cast_time_pct"]
script = ExtResource("2_rule")
name = &"cast_time_pct"
number = 100.0
minimum = 10.0
maximum = 1000.0
unit = "%"
description = "THE STAFF (owner, 2026-10-20): every spell's cast time, in percent of what its SpellDef says (a balance dial: 80 makes casting snappier). Whether a cast roots you is its own, not this."

[sub_resource type="Resource" id="Rule_meta_alarm_pct"]
script = ExtResource("2_rule")
name = &"meta_alarm_pct"
number = 45.0
minimum = 0.0
maximum = 100.0
unit = "%"
description = "THE META ALARM (LOOT_AND_STYLES.md section 7.5, owner priority): a weapon type dealing more than this share of an hour's damage to foes is an alarm (meta_share.alarm, a warning in the server's log, red on the telemetry page). 0: never."

[sub_resource type="Resource" id="Rule_meta_alarm_min_hits"]
script = ExtResource("2_rule")
name = &"meta_alarm_min_hits"
kind = 1
number = 50.0
minimum = 0.0
maximum = 100000.0
unit = "hits"
description = "THE META ALARM: an hour needs at least this many hits on foes before a share can be an alarm (two friends with one sword each are no meta)."

[sub_resource type="Resource" id="Rule_meta_keep_days"]
script = ExtResource("2_rule")
name = &"meta_keep_days"
number = 14.0
minimum = 1.0
maximum = 365.0
unit = "days"
description = "THE META: how long the database keeps each closed hour's shares (meta_share). The host's chronicle keeps them forever either way."

[sub_resource type="Resource" id="Rule_meta_period_s"]
script = ExtResource("2_rule")
name = &"meta_period_s"
kind = 1
number = 3600.0
minimum = 10.0
maximum = 86400.0
unit = "s"
description = "THE META: how long a period the weapon shares are rolled up over (an hour). A tally in progress closes when its own period ends."

[resource]
script = ExtResource("1_set")
