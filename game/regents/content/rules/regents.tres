description = "COMBAT: a training dummy is whole again this long after its last hit."

[sub_resource type="Resource" id="Rule_seen_reach"]
script = ExtResource("2_rule")
name = &"seen_reach_m"
number = 25.0
minimum = 5.0
maximum = 100.0
unit = "m"
description = "THE WORLD MAP (Luke, 2026-10-26): how near a node you must have been for the map to name it (\"Coal rock\"); one you have not been this near is its skill and ??? (\"Mining ???\")."

[sub_resource type="Resource" id="Rule_flinch"]
script = ExtResource("2_rule")
name = &"flinch_ms"
number = 350.0
minimum = 0.0
maximum = 2000.0
unit = "ms"
description = "COMBAT TIMING (owner, 2026-10-19): a heavy hit during a light swing's wind-up cancels it and flinches its fighter this long."

