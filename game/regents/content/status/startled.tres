[resource]
script = ExtResource("1_status")
status = 109
show_on_nameplate = false
color = Color(0.95, 0.85, 0.5, 1)
id = 40010
display_name = "Startled"
designer_notes = "A CREATURE THAT FLEES WAS HIT (hunting, 2026-11-09): the server sets it on a foe that never fights (`FoeDef.fights` off: a deer) on any hit, for regents.startle_ms, so its brain knows to bolt even from an arrow loosed from beyond its sight. It changes nothing else: the creature moves and is hit as ever. EVERY FIGHTING FOE TOO (the wolf, 2026-11-10; Luke, 2026-11-11: \"Every foe\"): one hit while it does nothing else is Startled as well, and its brain turns on the nearest player within its leash of home (a pack foe's packmates with it)."
