[gd_resource type="Resource" script_class="TraitDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://foundation/content/trait_def.gd" id="1_trait"]
[ext_resource type="Script" path="res://foundation/content/trait_atom.gd" id="2_atom"]

[sub_resource type="Resource" id="Atom_0"]
script = ExtResource("2_atom")
what = &"depletion"
mult = 0.5

[sub_resource type="Resource" id="Atom_1"]
script = ExtResource("2_atom")
what = &"work_time"
mult = 1.15
cost = true

[resource]
script = ExtResource("1_trait")
key = &"gentle"
applies_to = Array[StringName]([&"tool"])
gives = "nodes are half as likely to run out"
costs = "work 15% slower"
atoms = Array[ExtResource("2_atom")]([SubResource("Atom_0"), SubResource("Atom_1")])
id = 40009
display_name = "Gentle"
