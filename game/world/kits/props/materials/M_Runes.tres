// VectorOp:5
	vec3 n_out5p0 = vec3(n_out14p0.xyz) * vec3(n_out15p0);


// FloatConstant:16
	float n_out16p0 = 0.800000;


// Output:0
	ALPHA = n_out10p0.x;
	EMISSION = n_out5p0;
	ALPHA_SCISSOR_THRESHOLD = n_out16p0;


}
"
