code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D Rune_Texture;
uniform vec4 Color : source_color = vec4(0.329412, 1.000000, 0.000000, 1.000000);
uniform float Emissive_Intensity = 4;



void fragment() {
	vec4 n_out10p0;
// Texture2D:10
	n_out10p0 = texture(Rune_Texture, UV);


// ColorParameter:14
