code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 Grass_A : source_color = vec4(0.321569, 0.372549, 0.274510, 1.000000);
uniform vec4 Grass_A2 : source_color = vec4(0.466667, 0.517647, 0.000000, 1.000000);
uniform sampler2D tex_frg_5;
uniform vec4 Dirt_A : source_color = vec4(0.380392, 0.352941, 0.176471, 1.000000);
uniform vec4 Dirt_B : source_color = vec4(0.415686, 0.368627, 0.000000, 1.000000);
