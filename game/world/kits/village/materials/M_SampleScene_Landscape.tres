uniform sampler2D tex_frg_15;
uniform sampler2D tex_frg_26;
uniform sampler2D tex_frg_21;
uniform sampler2D tex_frg_19;



void fragment() {
// ColorParameter:8
	vec4 n_out8p0 = Grass_A;


// ColorParameter:9
	vec4 n_out9p0 = Grass_A2;


// UVFunc:6
	vec2 n_in6p1 = vec2(0.20000, 0.20000);
	vec2 n_in6p2 = vec2(0.00000, 0.00000);
	vec2 n_out6p0 = (UV - n_in6p2) * n_in6p1 + n_in6p2;


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, n_out6p0);


// Mix:7
	vec3 n_out7p0 = mix(vec3(n_out8p0.xyz), vec3(n_out9p0.xyz), vec3(n_out5p0.xyz));


// ColorParameter:11
	vec4 n_out11p0 = Dirt_A;


// ColorParameter:12
	vec4 n_out12p0 = Dirt_B;


// Texture2D:14
	vec4 n_out14p0 = texture(tex_frg_14, UV);


// Mix:13
	vec3 n_out13p0 = mix(vec3(n_out11p0.xyz), vec3(n_out12p0.xyz), vec3(n_out14p0.xyz));


// Input:3
	vec4 n_out3p0 = COLOR;


// VectorDecompose:4
	float n_out4p0 = vec3(n_out3p0.xyz).x;
	float n_out4p1 = vec3(n_out3p0.xyz).y;
	float n_out4p2 = vec3(n_out3p0.xyz).z;


// Mix:10
	vec3 n_out10p0 = mix(n_out7p0, n_out13p0, vec3(n_out4p0));


// UVFunc:17
	vec2 n_in17p1 = vec2(0.35000, 0.35000);
	vec2 n_in17p2 = vec2(0.00000, 0.00000);
	vec2 n_out17p0 = (UV - n_in17p2) * n_in17p1 + n_in17p2;


// Texture2D:15
	vec4 n_out15p0 = texture(tex_frg_15, n_out17p0);


// Mix:2
	vec3 n_out2p0 = mix(n_out10p0, vec3(n_out15p0.xyz), vec3(n_out4p2));


// FloatConstant:27
	float n_out27p0 = 1.000000;


// UVFunc:22
	vec2 n_in22p1 = vec2(0.35000, 0.35000);
	vec2 n_in22p2 = vec2(0.00000, 0.00000);
	vec2 n_out22p0 = (UV - n_in22p2) * n_in22p1 + n_in22p2;


// Texture2D:26
	vec4 n_out26p0 = texture(tex_frg_26, n_out22p0);


// Mix:24
	vec3 n_out24p0 = mix(vec3(n_out27p0), vec3(n_out26p0.xyz), vec3(n_out4p2));


// Texture2D:21
	vec4 n_out21p0 = texture(tex_frg_21, UV);


// UVFunc:20
	vec2 n_in20p1 = vec2(0.35000, 0.35000);
	vec2 n_in20p2 = vec2(0.00000, 0.00000);
	vec2 n_out20p0 = (UV - n_in20p2) * n_in20p1 + n_in20p2;


// Texture2D:19
	vec4 n_out19p0 = texture(tex_frg_19, n_out20p0);


// Mix:18
	vec3 n_out18p0 = mix(vec3(n_out21p0.xyz), vec3(n_out19p0.xyz), vec3(n_out4p2));


// Output:0
	ALBEDO = n_out2p0;
	ROUGHNESS = n_out24p0.x;
	NORMAL_MAP = n_out18p0;


}
