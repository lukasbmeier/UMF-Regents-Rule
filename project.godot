; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="UMF Template"
run/main_scene="res://game/greybox_game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene.dedicated_server="res://sidecar/sidecar_main.tscn"

[autoload]

SpacetimeDB="*res://spacetime_bindings/schema/spacetime_autoload.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
SignalBus="*res://foundation/core/signal_bus.gd"
Settings="*res://foundation/core/settings.gd"
MouseCapture="*res://foundation/core/mouse_capture.gd"
ClockSync="*res://foundation/core/clock_sync.gd"
SpaceTimeSync="*res://foundation/net/spacetime_sync.gd"
InterestManager="*res://foundation/net/interest_manager.gd"
EntityRegistry="*res://foundation/core/entity_registry.gd"
EntitySpawner="*res://foundation/core/entity_spawner.gd"
HotRules="*res://foundation/core/hot_rules.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_call_argument=1

[editor_plugins]

enabled=PackedStringArray("res://addons/SpacetimeDB/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/umf_export/plugin.cfg", "res://addons/umf_content/plugin.cfg")

