  "spots": {
    "_comment": "Keyed by the level bake's spot ids (shared/world/<level>.json). Loot weights are relative within a spot. bite_speed divides the bite delay: above 1 bites come faster. min_rod is the rod tier that reaches the spot AT ALL (Fishing for Compliments: where you cast decides what you catch, and how far your rod throws decides where you can cast): no part of it is in reach of a lesser rod from anywhere a player can stand, and some of it is in reach of that one. The LEVEL makes it true, by where it puts the spot; server/tests/level.rs checks every baked level against it.",
    "dock_end":         { "min_rod": 0, "bite_speed": 1.4,  "loot": { "fish_trash": 55, "fish_decent": 25, "junk_light": 15, "fish_nice": 5 } },
    "village_shallows": { "min_rod": 0, "bite_speed": 1.2,  "loot": { "junk_light": 38, "junk_heavy": 26, "fish_trash": 22, "fish_decent": 6, "treasure": 8 } },
    "reed_bay":         { "min_rod": 0, "bite_speed": 1.6,  "loot": { "fish_trash": 45, "fish_decent": 35, "fish_nice": 12, "junk_light": 8 } },
    "meadow_pond":      { "min_rod": 0, "bite_speed": 1.3,  "loot": { "fish_trash": 50, "fish_decent": 30, "fish_nice": 10, "junk_light": 10 } },
