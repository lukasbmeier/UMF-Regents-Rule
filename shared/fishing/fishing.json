  "conditions": {
    "_comment": "THE TIME OF DAY AND THE WEATHER (DECISIONS #168). Each round is one time of day, in the order of times (round 1 the first, then round and round), and has weather rolled from its seed when its lobby opens, by weight; the server keeps both in fishing_conditions and every client draws them. They change what bites: bite_speed divides the bite delay (times the spot's), and likes multiply a category's loot weight (or one catch's, inside its category) under that time or weather. A condition a category does not name leaves it as it is.",
    "times": [
      { "id": "dawn",  "name": "Dawn",  "bite_speed": 1.2 },
      { "id": "day",   "name": "Day",   "bite_speed": 1.0 },
      { "id": "dusk",  "name": "Dusk",  "bite_speed": 1.25 },
      { "id": "night", "name": "Night", "bite_speed": 0.9 }
    ],
    "weather": [
      { "id": "clear",    "name": "Clear",    "weight": 50, "bite_speed": 1.0 },
      { "id": "overcast", "name": "Overcast", "weight": 25, "bite_speed": 1.1 },
      { "id": "rain",     "name": "Rain",     "weight": 17, "bite_speed": 1.3 },
      { "id": "fog",      "name": "Fog",      "weight": 8,  "bite_speed": 0.95 }
    ],
    "likes": {
      "fish_trash":   { "day": 1.3, "clear": 1.2 },
      "fish_decent":  { "dawn": 1.3, "overcast": 1.3 },
      "fish_nice":    { "dawn": 1.5, "dusk": 1.6, "rain": 1.4 },
      "fish_whoa":    { "night": 2.0, "fog": 1.8, "dusk": 1.3 },
      "fish_illegal": { "night": 1.8, "fog": 1.6 },
      "junk_light":   { "rain": 1.5 },
      "junk_heavy":   { "rain": 1.3, "fog": 1.2 },
