[sub_resource type="BTDynamicSelector" id="BTDynamicSelector_root"]
custom_name = "A melee foe, in the order it minds things"
children = [SubResource("BTAction_foe_slain"), SubResource("BTAction_foe_go_home"), SubResource("BTAction_foe_rest"), SubResource("BTAction_foe_chase"), SubResource("BTAction_foe_wait_turn"), SubResource("BTAction_foe_close_in"), SubResource("BTAction_foe_swing")]

[resource]
description = "A MELEE FOE (the skeletons, the wolf; Luke's F2, 2026-11-12): the first of these that is its to do, each think (a dynamic selector: tried from the top every time). The tasks are sidecar/npc/brains/regents/tasks/; each calls a step of RegentsFoeBrain (foe.gd), which keeps what the foe knows (its target, its turn, its string, its pack). A foe is given this tree by FoeDef.behavior = melee; its numbers (notice, leash, reach, rest) are its FoeDef's."
blackboard_plan = SubResource("BlackboardPlan_foe")
root_task = SubResource("BTDynamicSelector_root")
