[sub_resource type="BTDynamicSelector" id="BTDynamicSelector_root"]
custom_name = "A foe that shoots, in the order it minds things"
children = [SubResource("BTAction_foe_slain"), SubResource("BTAction_foe_go_home"), SubResource("BTAction_foe_rest"), SubResource("BTAction_foe_hold_lock"), SubResource("BTAction_foe_shove"), SubResource("BTAction_foe_step_back"), SubResource("BTAction_foe_approach"), SubResource("BTAction_foe_shoot")]

[resource]
description = "A FOE THAT SHOOTS (the skeleton archer; Luke's F1-F6, 2026-11-12): the first of these that is its to do, each think (a dynamic selector: tried from the top every time). Slain, home and finding a target are the melee tree's; then it holds a draw it has begun, shoves a target in its reach, steps back from one that is close (seldom: it is caught), walks in to its range, and shoots. A foe is given this tree by FoeDef.behavior = ranged; its numbers (shot_range_m, shot_rest_ms, back_m, back_every_ms) are its FoeDef's, and its shot is its kit's first skill a bolt SpellDef flies."
blackboard_plan = SubResource("BlackboardPlan_foe")
root_task = SubResource("BTDynamicSelector_root")
