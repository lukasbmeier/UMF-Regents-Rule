extends SceneTree
## Writes the bindings' schema fingerprint (DECISIONS #164) and contract (#198): what the client compares with the
## server's before it connects. `tools/publish.sh --codegen` runs it after codegen; run it by hand
## only after a codegen of your own:
##   godot --headless --path . -s res://tools/write_schema_fingerprint.gd

const FINGERPRINT: GDScript = preload("res://foundation/net/schema_fingerprint.gd")
const SCHEMA: String = "res://spacetime_bindings/codegen_debug/unparsed_schema_umf.json"
const OUT: String = "res://spacetime_bindings/schema_fingerprint.json"
const CONTRACT: GDScript = preload("res://foundation/net/schema_contract.gd")
## What this build needs from a server (SchemaContract, DECISIONS #198), checked at connect.
const CONTRACT_OUT: String = "res://spacetime_bindings/schema_contract.json"


func _initialize() -> void:
	if not FileAccess.file_exists(SCHEMA):
		printerr("no schema at %s: run codegen first" % SCHEMA)
		quit(1)
		return
	var fp: String = FINGERPRINT.of(FileAccess.get_file_as_string(SCHEMA))
	if fp.is_empty():
		printerr("%s is not a schema" % SCHEMA)
		quit(1)
		return
	var f: FileAccess = FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string(JSON.stringify({
		"fingerprint": fp,
		"note": "GENERATED by tools/write_schema_fingerprint.gd at codegen. The client refuses a server whose schema differs (DECISIONS #164).",
	}, "\t") + "\n")
	f.close()
	print("schema fingerprint: ", fp)
	var contract: Dictionary = CONTRACT.of(FileAccess.get_file_as_string(SCHEMA))
	var c: FileAccess = FileAccess.open(CONTRACT_OUT, FileAccess.WRITE)
	contract["note"] = "GENERATED by tools/write_schema_fingerprint.gd at codegen: what this build needs from a server (DECISIONS #198). A server with more is fine."
	c.store_string(JSON.stringify(contract, "	", true) + "
")
	c.close()
	print("schema contract: %d tables, %d reducers" % [(contract.get("tables", {}) as Dictionary).size(),
		(contract.get("reducers", {}) as Dictionary).size()])
	quit()
